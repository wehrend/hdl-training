diff --git a/27_code_to_chip/01-synthesis/hex_display.v b/27_code_to_chip/01-synthesis/hex_display.v
new file mode 100644
index 0000000..ce7c3de
--- /dev/null
+++ b/27_code_to_chip/01-synthesis/hex_display.v
@@ -0,0 +1,24 @@
+// The 7-segment decoder from chapter 23 on real hardware.
+// The four buttons form a 4-bit number (button 1 = bit 0), the right display shows it as a hex digit.
+// The Go Board's segments are active low (0 = segment on), so the outputs of the decoder are inverted.
+module hex_display (
+    input  wire i_Switch_1,
+    input  wire i_Switch_2,
+    input  wire i_Switch_3,
+    input  wire i_Switch_4,
+    output wire o_Segment2_A,
+    output wire o_Segment2_B,
+    output wire o_Segment2_C,
+    output wire o_Segment2_D,
+    output wire o_Segment2_E,
+    output wire o_Segment2_F,
+    output wire o_Segment2_G
+);
+    wire [3:0] value = {i_Switch_4, i_Switch_3, i_Switch_2, i_Switch_1};
+    wire [6:0] seg;                                  // {g, f, e, d, c, b, a}, 1 = on
+
+    seven_seg dec (.value(value), .seg(seg));
+
+    assign {o_Segment2_G, o_Segment2_F, o_Segment2_E, o_Segment2_D,
+            o_Segment2_C, o_Segment2_B, o_Segment2_A} = ~seg;
+endmodule
diff --git a/27_code_to_chip/01-synthesis/hex_display_tb.v b/27_code_to_chip/01-synthesis/hex_display_tb.v
new file mode 100644
index 0000000..de48ee4
--- /dev/null
+++ b/27_code_to_chip/01-synthesis/hex_display_tb.v
@@ -0,0 +1,37 @@
+`timescale 1ns / 1ps
+
+// Testbench for hex_display: all 16 button combinations, checked against the decoder table.
+module hex_display_tb;
+    reg  [3:0] sw;
+    wire a, b, c, d, e, f, g;
+    reg  [6:0] expected;
+    integer i, errors = 0;
+
+    hex_display dut (
+        .i_Switch_1(sw[0]), .i_Switch_2(sw[1]), .i_Switch_3(sw[2]), .i_Switch_4(sw[3]),
+        .o_Segment2_A(a), .o_Segment2_B(b), .o_Segment2_C(c), .o_Segment2_D(d),
+        .o_Segment2_E(e), .o_Segment2_F(f), .o_Segment2_G(g)
+    );
+
+    initial begin
+        for (i = 0; i < 16; i = i + 1) begin
+            sw = i;
+            #10;
+            case (i)                              // {g,f,e,d,c,b,a}, 1 = on (table from chapter 23)
+                0: expected = 7'b0111111;  1: expected = 7'b0000110;
+                2: expected = 7'b1011011;  3: expected = 7'b1001111;
+                4: expected = 7'b1100110;  5: expected = 7'b1101101;
+                6: expected = 7'b1111101;  7: expected = 7'b0000111;
+                8: expected = 7'b1111111;  9: expected = 7'b1101111;
+               10: expected = 7'b1110111; 11: expected = 7'b1111100;
+               12: expected = 7'b0111001; 13: expected = 7'b1011110;
+               14: expected = 7'b1111001; 15: expected = 7'b1110001;
+            endcase
+            if ({g, f, e, d, c, b, a} !== ~expected) errors = errors + 1;
+            $display("buttons %b  pins gfedcba = %b%b%b%b%b%b%b", sw, g, f, e, d, c, b, a);
+        end
+        if (errors == 0) $display("PASSED: all 16 digits (pins are active low)");
+        else             $display("FAILED: %0d errors", errors);
+        $finish;
+    end
+endmodule
diff --git a/27_code_to_chip/01-synthesis/seven_seg.v b/27_code_to_chip/01-synthesis/seven_seg.v
new file mode 100644
index 0000000..d2762fe
--- /dev/null
+++ b/27_code_to_chip/01-synthesis/seven_seg.v
@@ -0,0 +1,28 @@
+// 7-segment decoder for the hexadecimal digits 0..F
+// segment order: seg = {g, f, e, d, c, b, a}, 1 = segment on
+module seven_seg (
+    input  wire [3:0] value,
+    output reg  [6:0] seg
+);
+    always @(*) begin
+        case (value)
+            4'h0: seg = 7'b0111111;
+            4'h1: seg = 7'b0000110;
+            4'h2: seg = 7'b1011011;
+            4'h3: seg = 7'b1001111;
+            4'h4: seg = 7'b1100110;
+            4'h5: seg = 7'b1101101;
+            4'h6: seg = 7'b1111101;
+            4'h7: seg = 7'b0000111;
+            4'h8: seg = 7'b1111111;
+            4'h9: seg = 7'b1101111;
+            4'hA: seg = 7'b1110111;
+            4'hB: seg = 7'b1111100;
+            4'hC: seg = 7'b0111001;
+            4'hD: seg = 7'b1011110;
+            4'hE: seg = 7'b1111001;
+            4'hF: seg = 7'b1110001;
+            default: seg = 7'b0000000;
+        endcase
+    end
+endmodule
