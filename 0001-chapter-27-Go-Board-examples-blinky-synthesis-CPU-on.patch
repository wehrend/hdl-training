diff --git a/27_code_to_chip/00-blinky/blinky.v b/27_code_to_chip/00-blinky/blinky.v
new file mode 100644
index 0000000..b645c0a
--- /dev/null
+++ b/27_code_to_chip/00-blinky/blinky.v
@@ -0,0 +1,21 @@
+// Blinky - the "hello world" of FPGAs.
+// A free-running counter divides the 25 MHz clock of the Go Board.
+// The four highest bits drive the four LEDs: they show a binary counter.
+// With WIDTH = 24, the highest bit toggles every 2^23 clock cycles,
+// so LED 4 is on for 0.34 s and off for 0.34 s.
+module blinky #(
+    parameter WIDTH = 24
+) (
+    input  wire i_Clk,
+    output wire o_LED_1,
+    output wire o_LED_2,
+    output wire o_LED_3,
+    output wire o_LED_4
+);
+    reg [WIDTH-1:0] count = 0;          // initial value: the iCE40 starts with 0
+
+    always @(posedge i_Clk)
+        count <= count + 1;
+
+    assign {o_LED_4, o_LED_3, o_LED_2, o_LED_1} = count[WIDTH-1 -: 4];
+endmodule
diff --git a/27_code_to_chip/00-blinky/blinky_tb.v b/27_code_to_chip/00-blinky/blinky_tb.v
new file mode 100644
index 0000000..5f2cf63
--- /dev/null
+++ b/27_code_to_chip/00-blinky/blinky_tb.v
@@ -0,0 +1,28 @@
+`timescale 1ns / 1ps
+
+// Testbench for blinky: with WIDTH = 6 instead of 24, the LEDs change every 4 clock cycles,
+// so we can watch them in simulation (with 24 bits we would wait millions of cycles).
+module blinky_tb;
+    reg  clk = 0;
+    wire led1, led2, led3, led4;
+    integer i, errors = 0;
+
+    always #20 clk = ~clk;              // 25 MHz: period 40 ns
+
+    blinky #(.WIDTH(6)) dut (
+        .i_Clk(clk), .o_LED_1(led1), .o_LED_2(led2), .o_LED_3(led3), .o_LED_4(led4)
+    );
+
+    initial begin
+        $dumpfile("blinky.vcd");
+        $dumpvars(0, blinky_tb);
+        for (i = 1; i <= 64; i = i + 1) begin
+            @(posedge clk); #1;
+            if ({led4, led3, led2, led1} !== i[5:2]) errors = errors + 1;
+            if (i % 4 == 0) $display("cycle %2d  LEDs (4..1) = %b%b%b%b", i, led4, led3, led2, led1);
+        end
+        if (errors == 0) $display("PASSED: LEDs show bits 5..2 of the counter");
+        else             $display("FAILED: %0d errors", errors);
+        $finish;
+    end
+endmodule
